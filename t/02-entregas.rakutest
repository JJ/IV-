# Check that the number of entregas is the same as the number of version strings
# for every existing objective file proyectos/objetivo-xxx.md

# Use fixtures when real production data is not present
BEGIN {
    unless "proyectos/usuarios.md".IO.s > 100 {
        %*ENV<IV_PROYECTOS> = "t/fixtures/proyectos/";
    }
}

use Test;
use IV::Stats;
use IV::Stats::Utils;

my $stats = IV::Stats.new;
my @objetivos = $stats.objetivos();
for @objetivos -> $objetivo {
    my $content = "{ PROYECTOS }objetivo-$objetivo.md".IO.slurp;
    my @versiones = $content.split("\n").grep(/"|"\s+ "v"/);
    my $entregas = $stats.hecha-entrega($objetivo) ∪ $stats.cumple-objetivo($objetivo);
    cmp-ok($entregas.elems, "<=", @versiones.elems,
        "Número de versiones no es igual que todas las entregas");
}

done-testing;
